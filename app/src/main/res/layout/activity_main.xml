
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:text="Gestión de contactos"
            android:textColor="#123B63"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="20dp"
            android:text="REGISTRO DE CONTACTO"
            android:textColor="#168AAD"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgContacto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="#DCEAF7"
            android:contentDescription="Fotografía del contacto"
            android:padding="24dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera" />

        <Button
            android:id="@+id/btnImagen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Agregar imagen"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="País"
            android:textColor="#123B63"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spPais"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#168AAD" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Nombre completo"
            android:textColor="#123B63"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el nombre"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="80"
            android:singleLine="true"
            android:autofillHints="name" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Teléfono"
            android:textColor="#123B63"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el número sin código de país"
            android:inputType="phone"
            android:maxLength="15"
            android:singleLine="true"
            android:autofillHints="phone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Nota"
            android:textColor="#123B63"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNota"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top|start"
            android:hint="Escriba una nota sobre el contacto"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#1769AA"
            android:text="Guardar contacto"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnVerContactos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#168AAD"
            android:text="Ver contactos guardados"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
